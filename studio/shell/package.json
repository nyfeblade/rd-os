{
  "name": "studio-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Studio A desktop shell — Chat + Board default, Code on demand. Mac + Windows.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node ./scripts/preview.js",
    "smoke": "node ./scripts/smoke.js",
    "prove": "node ./scripts/prove-chat.js && node ./scripts/prove-seat-connect.js && node ./scripts/prove-live.js",
    "prove:chat": "node ./scripts/prove-chat.js",
    "prove:seats": "node ./scripts/prove-seat-connect.js",
    "prove:live": "node ./scripts/prove-live.js",
    "test": "node ./scripts/smoke.js && node ./scripts/prove-chat.js && node ./scripts/prove-seat-connect.js && node ./scripts/prove-live.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron": "^37.3.1"
  }
}
