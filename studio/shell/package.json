{
  "name": "studio-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Studio A desktop shell — Chat + Board default, Code on demand. Mac + Windows.",
  "author": "rd-os",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node ./scripts/preview.js",
    "smoke": "node ./scripts/smoke.js",
    "test": "node ./scripts/smoke.js",
    "pack:mac": "node ./scripts/build-icon.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --x64 --arm64",
    "dist:mac": "node ./scripts/make-dmg.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^25.1.8"
  }
}
